{
  "name": "up-and-out-web",
  "version": "0.1.0",
  "private": true,
  "description": "Up and Out: 45 illustrated factory rooms with portrait video, photo favours and personalised spoken verdicts",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "build": "node scripts/build.js && node scripts/floor-guide.js",
    "dev": "node scripts/dev.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.cjs",
    "prestart": "npm run build",
    "predev": "npm run build",
    "test:browser:response": "node tests/browser-response.cjs",
    "test:browser:lift": "node tests/browser-lift.cjs",
    "test:browser:memories": "node tests/browser-memories.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@elevenlabs/client": "^1.25.0",
    "@reactor-team/js-sdk": "^3.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
